<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns
         http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
<!-- Created by igraph -->
  <key id="e_length" for="edge" attr.name="length" attr.type="double"/>
  <key id="e_speed" for="edge" attr.name="speed" attr.type="double"/>
  <key id="e_lanes" for="edge" attr.name="lanes" attr.type="double"/>
  <key id="n_x" for="node" attr.name="x" attr.type="double"/>
  <key id="n_y" for="node" attr.name="y" attr.type="double"/>
  <graph id="G" edgedefault="directed">
    <node id="n0">
      <data key="n_x">0</data>
      <data key="n_y">0</data>
    </node>
    <node id="n1">
      <data key="n_x">0.5</data>
      <data key="n_y">0.5</data>
    </node>
    <node id="n2">
      <data key="n_x">0.5</data>
      <data key="n_y">-0.5</data>
    </node>
    <node id="n3">
      <data key="n_x">1</data>
      <data key="n_y">0</data>
    </node>


    <edge id='e1' source="n0" target="n1"> 
      <data key="e_length">968</data>
      <data key="e_speed">50</data>
      <data key="e_lanes">2</data>
    </edge>
    <edge id='e2' source="n1" target="n3">
      <data key="e_length">5037</data>
      <data key="e_speed">110</data>
      <data key="e_lanes">2</data>
    </edge>
    <edge id='e3' source="n2" target="n3">
      <data key="e_length">1252</data>
      <data key="e_speed">90</data>
        <data key="e_lanes">2</data>
    </edge>
    <edge id='e4' source="n0" target="n2">
      <data key="e_length">2933</data>
      <data key="e_speed">70</data>
      <data key="e_lanes">2</data>
    </edge>
    <edge id='e5a' source="n1" target="n2">
      <data key="e_length">478</data>
      <data key="e_speed">30</data>
      <data key="e_lanes">1</data>
    </edge>
    <edge id='e5b' source="n2" target="n1">
      <data key="e_length">490</data>
      <data key="e_speed">30</data>
      <data key="e_lanes">1</data>
    </edge>
  </graph>
</graphml>
